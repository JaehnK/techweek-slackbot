SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
DATABASE_URL=postgres://user:password@host:5432/dbname
ANTHROPIC_API_KEY=sk-ant-...
PORT=3000
# 관리자 대시보드(GET /admin) 접근 토큰. 미설정이면 /admin은 404로 응답한다.
# 예: openssl rand -hex 24
ADMIN_TOKEN=
# 행사 기간(YYYY-MM-DD). 이 범위 밖 날짜로 파싱된 이벤트는 저장하지 않는다. 기본값은 2026-07-24 ~ 2026-07-31.
EVENT_WINDOW_FROM=
EVENT_WINDOW_TO=
